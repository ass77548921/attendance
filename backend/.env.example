# ── 資料庫設定 ───────────────────────────────────
# MySQL 由機器維護人員自行建置與管理，不在此專案範圍內。
# 請填入外部 MySQL 的連線資訊，DB_URL 需包含完整 JDBC URL。
DB_URL=jdbc:mysql://localhost:3306/attendance?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=attendance
DB_PASSWORD=change_me

# ── JWT ───────────────────────────────────────────
# 至少 256 bits 的隨機字串，可用：openssl rand -base64 64
JWT_SECRET=change-me-to-a-long-random-secret-key-at-least-256-bits

# ── SMTP（Gmail 範例） ─────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
# Gmail App Password（非帳號密碼）：https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your-app-password

# ── 通知寄件人 ───────────────────────────────────
NOTIFICATION_FROM_EMAIL=noreply@your-domain.com

# ── 伺服器 ────────────────────────────────────────
SERVER_PORT=8080

# ── CORS（多來源以逗號分隔） ───────────────────────
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:8082,http://localhost:8083
APP_CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
APP_CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Requested-With
APP_CORS_EXPOSED_HEADERS=Authorization
APP_CORS_ALLOW_CREDENTIALS=true
APP_CORS_MAX_AGE_SECONDS=3600

